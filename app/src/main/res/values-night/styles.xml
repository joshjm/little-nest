<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#96C9A7</item>
        <item name="android:textColorPrimary">#E8E4D8</item>
        <item name="android:textColorSecondary">#A8B1A4</item>
        <item name="android:windowBackground">#111613</item>
        <item name="android:alertDialogTheme">@style/NestDialog</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#111613</item>
        <item name="android:navigationBarColor">#111613</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="NestDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#96C9A7</item>
        <item name="android:textColorPrimary">#E8E4D8</item>
        <item name="android:textColorSecondary">#A8B1A4</item>
        <item name="android:windowBackground">#1A211D</item>
        <item name="android:buttonStyle">@style/NestDialogButton</item>
    </style>
    <style name="NestDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#96C9A7</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
