<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#2B5B45</item>
        <item name="android:textColorPrimary">#26352C</item>
        <item name="android:textColorSecondary">#576357</item>
        <item name="android:windowBackground">#F7F4EC</item>
        <item name="android:alertDialogTheme">@style/NestDialog</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F4EC</item>
        <item name="android:navigationBarColor">#F7F4EC</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="NestDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#2B5B45</item>
        <item name="android:textColorPrimary">#26352C</item>
        <item name="android:textColorSecondary">#576357</item>
        <item name="android:windowBackground">#FFFDF8</item>
        <item name="android:buttonStyle">@style/NestDialogButton</item>
    </style>
    <style name="NestDialogButton" parent="android:style/Widget.Material.Light.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#2B5B45</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="WidgetButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingHorizontal">6dp</item>
    </style>
    <style name="WidgetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textColor">@color/widget_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="WidgetValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
